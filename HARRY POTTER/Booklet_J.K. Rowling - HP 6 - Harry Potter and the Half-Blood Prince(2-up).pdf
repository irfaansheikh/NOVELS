         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Harry Potter and the Half-Blood Prince</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Scanned in the dark by BeB for everyone who has purchased the book and laments the lack of any eBook releases by the Author.</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Reference Quality Electronic Book Version of the American Scholastic Hard Cover</rdf:li>
            </rdf:Alt>
