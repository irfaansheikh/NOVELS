         <dc:subject>
            <rdf:Bag>
               <rdf:li>It all comes down to this - a final face off between good and evil. With Ron and Hermione at his side</rdf:li>
               <rdf:li>he's trying to hunt down Voldemort's Horcruxes</rdf:li>
               <rdf:li>escape danger at every turn</rdf:li>
               <rdf:li>and find a way to defeat evil once and for all.</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                           
